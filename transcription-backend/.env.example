# Qwen API Key (required for /summarize and /generate-quiz endpoints)
# Get your key from Alibaba Cloud Model Studio (DashScope), OpenRouter, Groq, or SiliconFlow
QWEN_API_KEY=sk-...

# Qwen API Base URL (OpenAI-compatible)
# Default (Alibaba DashScope Intl): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# If using OpenRouter: https://openrouter.ai/api/v1
# If using Groq: https://api.groq.com/openai/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Qwen Model Name
# Recommended options: qwen-plus, qwen-turbo, qwen-max, qwen2.5-72b-instruct
# If using OpenRouter: qwen/qwen-2.5-72b-instruct
QWEN_MODEL=qwen-plus

# Whisper model to load for audio transcription (options: tiny, base, small, medium, large)
# Recommended for Railway starter tier (512MB-1GB RAM): base or tiny
# Recommended for 4GB+ RAM instances: medium
WHISPER_MODEL=base
